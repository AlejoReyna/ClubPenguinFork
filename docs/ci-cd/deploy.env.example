# Copiar a ~/.config/clubpenguin-lab/deploy.env en el Mac del agente y proteger:
#   mkdir -p ~/.config/clubpenguin-lab && chmod 700 ~/.config/clubpenguin-lab
#   cp docs/ci-cd/deploy.env.example ~/.config/clubpenguin-lab/deploy.env
#   chmod 600 ~/.config/clubpenguin-lab/deploy.env
# Los scripts rechazan el archivo si lo pueden leer otros usuarios y rechazan los
# valores de ejemplo de este repositorio. Nunca subirlo a Git.
# Las variables de entorno (p. ej. variables del pipeline) tienen prioridad.

# Dominio público servido por el túnel (se permite como origen del proxy WebSocket)
CP_PUBLIC_HOSTNAME=club.example.com
# Raspberry Pi en la LAN y usuario SSH (el API de Kubernetes se alcanza por túnel)
CP_PI_HOST=10.0.0.20
CP_PI_USER=operator
# Rango de la LAN con acceso a los puertos del juego (política game-ingress)
CP_LAN_CIDR=10.0.0.0/24
# ssh_config alternativo si ~/.ssh/config tiene opciones inválidas (opcional)
#CP_SSH_CONFIG=~/.config/clubpenguin-lab/ssh_config

# Azure: nombres de los recursos existentes (no son secretos, pero tampoco se publican)
CP_ACR_NAME=exampleacr
CP_STATE_RESOURCE_GROUP=rg-example-state
CP_STATE_STORAGE_ACCOUNT=stexamplestate
#CP_STATE_CONTAINER=tfstate-clubpenguin
#CP_CLUSTER_STATE_KEY=cluster.tfstate
#CP_CLOUD_STATE_KEY=cloud.tfstate
#CP_BACKUP_CONTAINER=clubpenguin-backups
# Si se define, el login de Azure debe ser esta suscripción (evita usar la conexión equivocada)
#CP_AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000

# Opcionales
#CP_KUBECONFIG=~/.kube/clubpenguin-pi.yaml
#CP_NODE_NAME=penguin-pi
CP_PUFFLE_ENABLED=false
CP_PUFFLE_ALLOWED_PLAYERS=
CP_RELEASE_PINS=database=lab-002
