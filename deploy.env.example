# Operator configuration for the release/deploy scripts (read by scripts/lablib.py).
#
#   mkdir -p ~/.config/clubpenguin-lab && chmod 700 ~/.config/clubpenguin-lab
#   cp deploy.env.example ~/.config/clubpenguin-lab/deploy.env
#   chmod 600 ~/.config/clubpenguin-lab/deploy.env
#
# The scripts refuse a file that other users can read, and refuse placeholder
# values such as example.com, so a half-configured checkout fails before it
# builds or plans.
# Environment variables (for example CI variables) take precedence over this file.
# Never commit the real file.

# Public hostname served through the Cloudflare tunnel (allowed WebSocket origin)
CP_PUBLIC_HOSTNAME=club.example.com
# Raspberry Pi on the LAN and its SSH user (the Kubernetes API is reached through a tunnel)
CP_PI_HOST=10.0.0.20
CP_PI_USER=operator
# LAN range allowed to reach the game ports (game-ingress NetworkPolicy)
CP_LAN_CIDR=10.0.0.0/24
# Alternative ssh_config if ~/.ssh/config contains options OpenSSH rejects (optional)
#CP_SSH_CONFIG=~/.config/clubpenguin-lab/ssh_config

# Azure: names of the existing resources (not secrets, but not published either)
CP_ACR_NAME=exampleacr
CP_STATE_RESOURCE_GROUP=rg-example-state
CP_STATE_STORAGE_ACCOUNT=stexamplestate
#CP_STATE_CONTAINER=tfstate-clubpenguin
#CP_CLUSTER_STATE_KEY=cluster.tfstate
#CP_CLOUD_STATE_KEY=cloud.tfstate
#CP_BACKUP_CONTAINER=clubpenguin-backups
# When set, the active Azure login must be this subscription
#CP_AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000

# Optional
#CP_KUBECONFIG=~/.kube/clubpenguin-pi.yaml
#CP_NODE_NAME=penguin-pi
CP_PUFFLE_ENABLED=false
CP_PUFFLE_ALLOWED_PLAYERS=
# Navbar «Diálogos» panel: public, allow-listed feed of the bots dialog log
CP_DIALOG_FEED_ENABLED=false
CP_RELEASE_PINS=database=lab-002
CP_PROXY_EXTRA_HOSTS=localhost,127.0.0.1
